{
  "name": "uwcmp/wordpress-content-moderation",
  "description": "Local-first WordPress content policy and moderation platform",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2",
    "ext-mbstring": "*",
    "ext-intl": "*",
    "ext-dom": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "php-stubs/wordpress-stubs": "^6.8",
    "wp-coding-standards/wpcs": "^3.2",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "UWCMP\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "UWCMP\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=1G --debug",
    "lint": "phpcs",
    "benchmark": "php tools/benchmark.php",
    "evaluate": "php tools/evaluate.php",
    "package": "python3 tools/package.py"
  }
}
